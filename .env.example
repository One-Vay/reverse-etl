# Copy to `.env` before running `docker compose up`, or just run
# `./deploy.sh` — it creates `.env` from this file and generates
# SECRET_KEY / ENCRYPTION_KEY for you automatically.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reverse_etl
POSTGRES_PORT=5432

# --- Backend ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DEBUG=false
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=80
