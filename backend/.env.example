# Copy this file to `.env` and fill in real values for local development.
# Never commit your actual `.env` file.

# Async SQLAlchemy connection string.
# Use SQLite for quick local runs, or PostgreSQL for production-like setups.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reverse_etl

# Secret key used for JWT/session signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Fernet key used to encrypt sensitive fields (e.g. source passwords). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# Enable SQL echo and verbose error responses.
DEBUG=false
